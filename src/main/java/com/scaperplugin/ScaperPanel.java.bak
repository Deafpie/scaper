package com.scaperplugin;

import com.google.gson.JsonArray;
import com.google.gson.JsonElement;
import com.google.gson.JsonObject;
import com.google.gson.JsonParser;
import lombok.extern.slf4j.Slf4j;
import net.runelite.api.Client;
import net.runelite.client.ui.ColorScheme;
import net.runelite.client.ui.FontManager;
import net.runelite.client.ui.PluginPanel;
import okhttp3.MediaType;
import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.RequestBody;
import okhttp3.Response;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.net.URLEncoder;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.ScheduledFuture;
import java.util.concurrent.TimeUnit;

@Slf4j
public class ScaperPanel extends PluginPanel
{
	private static final MediaType JSON_TYPE = MediaType.parse("application/json; charset=utf-8");
	private static final String API_URL = "https://api.scaper.icu";
	private static final Color GOLD = new Color(212, 160, 23);
	private static final Color TAB_BG = new Color(30, 30, 30);
	private static final Color TAB_ACTIVE_BG = new Color(50, 45, 35);

	private static final String DESCRIPTION_NOT_LINKED =
		"Thank you for using Scaper!\n\n" +
		"Please press the button below to generate a code. Your code will " +
		"expire after 5 minutes. If the code doesn't work, click the generate " +
		"button again to get a new code.\n\n" +
		"You can link your OSRS account to your Discord account in one of two ways: " +
		"log into Scaper.icu and click \"Dashboard\" to enter your code, or add the " +
		"Scaper bot to your Discord server and use the /link command.";

	private static final String DESCRIPTION_LINKED =
		"Your OSRS account has been successfully linked to Discord via Scaper.";

	private static final String DESCRIPTION_LOGGED_OUT =
		"Log in to your OSRS account to get started.";

	private final Client client;
	private final OkHttpClient httpClient;
	private final ScaperPlugin plugin;

	// Tab buttons
	private JButton dashboardTab;
	private JButton marketTab;
	private JButton settingsTab;
	private String activeTab = "dashboard";

	// Card layout for tab content
	private CardLayout cardLayout;
	private JPanel cardPanel;

	// Dashboard tab components
	private JLabel tokenLabel;
	private JPanel tasksPanel;
	private JLabel dashboardMessageLabel;

	// Market tab components
	private JPanel marketPanel;
	private JLabel marketMessageLabel;

	// Settings tab components
	private JTextArea settingsDescriptionArea;
	private JLabel settingsStatusLabel;
	private JPanel codePanel;
	private JLabel codeLabel;
	private JLabel timerLabel;
	private JButton generateButton;
	private JButton unlinkButton;

	// State
	private final ScheduledExecutorService scheduler = Executors.newSingleThreadScheduledExecutor();
	private ScheduledFuture<?> countdownFuture;
	private ScheduledFuture<?> pollFuture;
	private volatile String cachedRsn;
	private volatile boolean linked;
	private volatile boolean loggedIn;

	public ScaperPanel(Client client, OkHttpClient httpClient, ScaperPlugin plugin)
	{
		super(false);
		this.client = client;
		this.httpClient = httpClient;
		this.plugin = plugin;

		setLayout(new BorderLayout());
		setBackground(ColorScheme.DARK_GRAY_COLOR);

		// ── Top section: title + tabs ──
		JPanel topPanel = new JPanel();
		topPanel.setLayout(new BoxLayout(topPanel, BoxLayout.Y_AXIS));
		topPanel.setBackground(ColorScheme.DARK_GRAY_COLOR);

		JLabel title = new JLabel("Scaper");
		title.setFont(FontManager.getRunescapeBoldFont().deriveFont(24f));
		title.setForeground(Color.WHITE);
		title.setHorizontalAlignment(SwingConstants.CENTER);
		title.setAlignmentX(Component.CENTER_ALIGNMENT);
		title.setBorder(new EmptyBorder(10, 10, 8, 10));
		topPanel.add(title);

		topPanel.add(buildTabBar());

		add(topPanel, BorderLayout.NORTH);

		// ── Card panel for tab content ──
		cardLayout = new CardLayout();
		cardPanel = new JPanel(cardLayout);
		cardPanel.setBackground(ColorScheme.DARK_GRAY_COLOR);

		cardPanel.add(buildDashboardPanel(), "dashboard");
		cardPanel.add(buildMarketPanel(), "market");
		cardPanel.add(buildSettingsPanel(), "settings");

		add(cardPanel, BorderLayout.CENTER);

		// ── Bottom: Inventory button ──
		JPanel bottomPanel = new JPanel(new BorderLayout());
		bottomPanel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		bottomPanel.setBorder(new EmptyBorder(6, 10, 10, 10));

		JButton inventoryButton = new JButton("Inventory");
		inventoryButton.setFont(FontManager.getRunescapeBoldFont().deriveFont(14f));
		inventoryButton.setBackground(GOLD);
		inventoryButton.setForeground(Color.BLACK);
		inventoryButton.setFocusPainted(false);
		inventoryButton.setPreferredSize(new Dimension(0, 36));
		inventoryButton.addActionListener(e -> onInventoryClicked());
		bottomPanel.add(inventoryButton, BorderLayout.CENTER);

		add(bottomPanel, BorderLayout.SOUTH);

		// Start in logged-out state
		showLoggedOut();
	}

	// ── Tab bar construction ───────────────────────────────────────────────────

	private JPanel buildTabBar()
	{
		JPanel tabBar = new JPanel(new GridLayout(1, 3, 0, 0));
		tabBar.setBackground(TAB_BG);
		tabBar.setMaximumSize(new Dimension(Integer.MAX_VALUE, 32));
		tabBar.setAlignmentX(Component.CENTER_ALIGNMENT);

		dashboardTab = createTabButton("Dashboard");
		marketTab = createTabButton("Market");
		settingsTab = createTabButton("Settings");

		dashboardTab.addActionListener(e -> switchTab("dashboard"));
		marketTab.addActionListener(e -> switchTab("market"));
		settingsTab.addActionListener(e -> switchTab("settings"));

		tabBar.add(dashboardTab);
		tabBar.add(marketTab);
		tabBar.add(settingsTab);

		return tabBar;
	}

	private JButton createTabButton(String text)
	{
		JButton btn = new JButton(text);
		btn.setFont(FontManager.getRunescapeSmallFont().deriveFont(12f));
		btn.setFocusPainted(false);
		btn.setBorderPainted(false);
		btn.setBackground(TAB_BG);
		btn.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
		btn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
		return btn;
	}

	private void switchTab(String tab)
	{
		activeTab = tab;
		cardLayout.show(cardPanel, tab);
		updateTabStyles();

		if (loggedIn)
		{
			if ("dashboard".equals(tab))
			{
				loadDashboard();
			}
			else if ("market".equals(tab))
			{
				loadMarketCases();
			}
		}
	}

	private void updateTabStyles()
	{
		styleTab(dashboardTab, "dashboard".equals(activeTab));
		styleTab(marketTab, "market".equals(activeTab));
		styleTab(settingsTab, "settings".equals(activeTab));
	}

	private void styleTab(JButton tab, boolean active)
	{
		if (active)
		{
			tab.setBackground(TAB_ACTIVE_BG);
			tab.setForeground(GOLD);
			tab.setBorder(BorderFactory.createMatteBorder(0, 0, 2, 0, GOLD));
		}
		else
		{
			tab.setBackground(TAB_BG);
			tab.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
			tab.setBorder(BorderFactory.createEmptyBorder(0, 0, 2, 0));
		}
	}

	// ── Dashboard panel ────────────────────────────────────────────────────────

	private JPanel buildDashboardPanel()
	{
		JPanel panel = new JPanel();
		panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
		panel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		panel.setBorder(new EmptyBorder(10, 10, 10, 10));

		// Token balance row
		JPanel tokenRow = new JPanel(new BorderLayout());
		tokenRow.setBackground(ColorScheme.DARKER_GRAY_COLOR);
		tokenRow.setBorder(new EmptyBorder(10, 12, 10, 12));
		tokenRow.setMaximumSize(new Dimension(Integer.MAX_VALUE, 44));
		tokenRow.setAlignmentX(Component.LEFT_ALIGNMENT);

		JLabel tokenTitle = new JLabel("Tokens");
		tokenTitle.setFont(FontManager.getRunescapeBoldFont().deriveFont(14f));
		tokenTitle.setForeground(GOLD);
		tokenRow.add(tokenTitle, BorderLayout.WEST);

		tokenLabel = new JLabel("0");
		tokenLabel.setFont(FontManager.getRunescapeBoldFont().deriveFont(14f));
		tokenLabel.setForeground(Color.WHITE);
		tokenLabel.setHorizontalAlignment(SwingConstants.RIGHT);
		tokenRow.add(tokenLabel, BorderLayout.EAST);

		panel.add(tokenRow);
		panel.add(Box.createVerticalStrut(10));

		// Dashboard message (shown when logged out or not linked)
		dashboardMessageLabel = new JLabel();
		dashboardMessageLabel.setFont(FontManager.getRunescapeSmallFont().deriveFont(12f));
		dashboardMessageLabel.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
		dashboardMessageLabel.setAlignmentX(Component.LEFT_ALIGNMENT);
		dashboardMessageLabel.setVisible(false);
		panel.add(dashboardMessageLabel);
		panel.add(Box.createVerticalStrut(6));

		// Daily tasks header
		JLabel tasksHeader = new JLabel("Daily Tasks");
		tasksHeader.setFont(FontManager.getRunescapeBoldFont().deriveFont(14f));
		tasksHeader.setForeground(Color.WHITE);
		tasksHeader.setAlignmentX(Component.LEFT_ALIGNMENT);
		panel.add(tasksHeader);
		panel.add(Box.createVerticalStrut(6));

		// Tasks list
		tasksPanel = new JPanel();
		tasksPanel.setLayout(new BoxLayout(tasksPanel, BoxLayout.Y_AXIS));
		tasksPanel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		tasksPanel.setAlignmentX(Component.LEFT_ALIGNMENT);
		panel.add(tasksPanel);

		// Filler
		panel.add(Box.createVerticalGlue());

		return panel;
