	// ── Market panel ───────────────────────────────────────────────────────────

	private JPanel buildMarketPanel()
	{
		JPanel panel = new JPanel();
		panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
		panel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		panel.setBorder(new EmptyBorder(10, 10, 10, 10));

		marketMessageLabel = new JLabel();
		marketMessageLabel.setFont(FontManager.getRunescapeSmallFont().deriveFont(12f));
		marketMessageLabel.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
		marketMessageLabel.setAlignmentX(Component.LEFT_ALIGNMENT);
		marketMessageLabel.setVisible(false);
		panel.add(marketMessageLabel);

		marketPanel = new JPanel();
		marketPanel.setLayout(new BoxLayout(marketPanel, BoxLayout.Y_AXIS));
		marketPanel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		marketPanel.setAlignmentX(Component.LEFT_ALIGNMENT);
		panel.add(marketPanel);

		panel.add(Box.createVerticalGlue());

		return panel;
	}

	// ── Settings panel ─────────────────────────────────────────────────────────

	private JPanel buildSettingsPanel()
	{
		JPanel panel = new JPanel();
		panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
		panel.setBackground(ColorScheme.DARK_GRAY_COLOR);
		panel.setBorder(new EmptyBorder(10, 10, 10, 10));

		// Description text
		settingsDescriptionArea = new JTextArea();
		settingsDescriptionArea.setWrapStyleWord(true);
		settingsDescriptionArea.setLineWrap(true);
		settingsDescriptionArea.setEditable(false);
		settingsDescriptionArea.setFocusable(false);
		settingsDescriptionArea.setOpaque(false);
		settingsDescriptionArea.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
		settingsDescriptionArea.setFont(FontManager.getRunescapeSmallFont().deriveFont(14f));
		settingsDescriptionArea.setAlignmentX(Component.LEFT_ALIGNMENT);
		settingsDescriptionArea.setMaximumSize(new Dimension(Integer.MAX_VALUE, Integer.MAX_VALUE));
		panel.add(settingsDescriptionArea);
		panel.add(Box.createVerticalStrut(10));

		// Status label
		settingsStatusLabel = new JLabel();
		settingsStatusLabel.setFont(FontManager.getRunescapeBoldFont().deriveFont(16f));
		settingsStatusLabel.setAlignmentX(Component.LEFT_ALIGNMENT);
		settingsStatusLabel.setBorder(new EmptyBorder(5, 0, 5, 0));
		settingsStatusLabel.setVisible(false);
		panel.add(settingsStatusLabel);

		// Code display panel
		codePanel = new JPanel();
		codePanel.setLayout(new BoxLayout(codePanel, BoxLayout.Y_AXIS));
		codePanel.setBackground(ColorScheme.DARKER_GRAY_COLOR);
		codePanel.setBorder(new EmptyBorder(15, 10, 15, 10));
		codePanel.setAlignmentX(Component.LEFT_ALIGNMENT);
		codePanel.setMaximumSize(new Dimension(Integer.MAX_VALUE, 90));

		codeLabel = new JLabel();
		codeLabel.setFont(FontManager.getRunescapeBoldFont().deriveFont(30f));
		codeLabel.setForeground(new Color(0, 200, 83));
		codeLabel.setAlignmentX(Component.CENTER_ALIGNMENT);
		codePanel.add(codeLabel);

		codePanel.add(Box.createVerticalStrut(4));

		timerLabel = new JLabel();
		timerLabel.setFont(FontManager.getRunescapeSmallFont().deriveFont(12f));
		timerLabel.setForeground(ColorScheme.LIGHT_GRAY_COLOR);
		timerLabel.setAlignmentX(Component.CENTER_ALIGNMENT);
		codePanel.add(timerLabel);

		codePanel.setVisible(false);
		panel.add(codePanel);
		panel.add(Box.createVerticalStrut(10));

